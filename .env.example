# --- Server ---
PORT=3000
# Postgres connection string (e.g. from Neon: https://neon.tech). When set,
# all data lives in Postgres and survives redeploys without a disk volume.
# Leave empty to use local SQLite (data/app.db).
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Password for the dashboard. REQUIRED before exposing the server publicly -
# without it anyone who finds the URL can upload videos and manage accounts.
ADMIN_PASSWORD=
# Public base URL of this server. MUST be reachable from the internet for
# Instagram publishing (Instagram pulls the clip from this URL) and for the
# OAuth callbacks. Use e.g. an ngrok/Cloudflare tunnel URL during development.
BASE_URL=http://localhost:3000

# --- Branding / clip settings ---
SITE_DOMAIN=www.clint.build
CLIP_DURATION_SECONDS=120
UPLOAD_INTERVAL_HOURS=3
# How many accounts can be connected per platform. Each video is assigned to
# one account per platform (least-used first) and all its parts stay there.
MAX_ACCOUNTS_PER_PLATFORM=5
# Render clips as vertical 1080x1920 with a blurred background (recommended for
# Shorts/Reels/TikTok). Set to false to keep the original aspect ratio.
VERTICAL_FORMAT=true
# Encoding speed vs quality. Presets from fast to slow:
# ultrafast > superfast > veryfast > fast > medium. Platforms re-encode
# uploads anyway, so fast presets cost viewers almost nothing.
VIDEO_CRF=20
VIDEO_PRESET=superfast
# 1920 = 1080x1920 output. Set 1280 for 720x1280: ~2x faster encodes and
# still fine for phone feeds - the biggest speed lever besides CPU cores.
VERTICAL_HEIGHT=1920
# Normalize audio loudness to -14 LUFS (what Shorts/Reels/TikTok target).
NORMALIZE_AUDIO=true

# --- Auto-subtitles (optional) ---
# When set, every clip gets word-by-word highlighted subtitles generated with
# OpenAI Whisper (about $0.006 per audio minute). Leave empty to skip subtitles.
OPENAI_API_KEY=
# Set to false to turn subtitles off without removing the key.
SUBTITLES=true
# With the same key, each clip also gets a unique AI-generated title,
# description and hashtags from its transcript, used when publishing.
GENERATE_METADATA=true
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- YouTube (Google Cloud Console -> OAuth client, YouTube Data API v3) ---
# Redirect URI to register: {BASE_URL}/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=public

# --- Instagram (Meta developer app, "Instagram API with Instagram Login") ---
# Redirect URI to register: {BASE_URL}/auth/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Meta app dashboards (Instagram/Facebook/Threads) require a webhook
# Callback URL + Verify token during setup. Use:
#   Callback URL: {BASE_URL}/webhooks/meta
#   Verify token: the value below (any string; must match what you type there)
META_VERIFY_TOKEN=shortform-verify

# --- TikTok (TikTok developer app, Content Posting API) ---
# Redirect URI to register: {BASE_URL}/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Unaudited TikTok apps may only post as SELF_ONLY (private). After your app
# passes TikTok's audit you can switch this to PUBLIC_TO_EVERYONE.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Scopes requested at connect time - every one must be approved for your app
# in the TikTok developer portal or login fails with a "scope" error.
# video.list (Display API) powers Analytics metrics; remove it if your app
# doesn't have that scope: TIKTOK_SCOPES=user.info.basic,video.publish
TIKTOK_SCOPES=user.info.basic,video.publish,video.list

# --- Facebook (same Meta developer app or a separate one; Facebook Login
# product with pages_show_list, pages_manage_posts, pages_read_engagement) ---
# Redirect URI to register: {BASE_URL}/auth/facebook/callback
# Connecting adds every Facebook Page you manage as its own account.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Business-type Meta apps use "Facebook Login for Business": create a
# configuration (Facebook Login for Business > Configurations) with the
# pages_show_list, pages_manage_posts and pages_read_engagement permissions
# and put its Configuration ID here. Leave empty for Consumer-type apps.
FACEBOOK_CONFIG_ID=

# --- X / Twitter (developer.x.com app with OAuth 2.0 enabled) ---
# Redirect URI to register: {BASE_URL}/auth/x/callback
# Scopes used: tweet.read, tweet.write, users.read, media.write, offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Threads (Meta developer app with the "Threads API" use case) ---
# Redirect URI to register: {BASE_URL}/auth/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- Pinterest (developers.pinterest.com app) ---
# Redirect URI to register: {BASE_URL}/auth/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# --- LinkedIn (developer.linkedin.com app with "Share on LinkedIn" +
# "Sign In with LinkedIn using OpenID Connect" products) ---
# Redirect URI to register: {BASE_URL}/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Post as LinkedIn Company Pages you admin (instead of only your personal
# feed). Requires the "Community Management API" product approved on the
# LinkedIn app first - enabling this without it breaks the login.
LINKEDIN_COMPANY_PAGES=false

# --- Disk cleanup ---
# Original uploads are deleted this many days after successful processing
# (clips are what get published; originals are only needed for re-processing).
# 0 disables.
DELETE_ORIGINALS_AFTER_DAYS=7
# Fully-published videos (rows + clips + files) are pruned after this many
# days. 0 (default) keeps everything forever.
PRUNE_VIDEOS_AFTER_DAYS=0

# --- Optional ---
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
